# Server
PORT=4173
HOST=0.0.0.0
NODE_ENV=production

# Required: generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# Database
# Leave DATABASE_URL empty to use local SQLite.
# For Render free + Supabase, paste the Supabase Session Pooler URL here.
DATABASE_URL=
# SQLite file (used only when DATABASE_URL is empty).
DB_PATH=./data/arcana.db

# Email verification
# console: prints codes to the server log (local development only)
# smtp: QQ Mail SMTP (local/VPS; Render free blocks SMTP ports)
# mailjet: HTTPS email API (single sender works with QQ; required for Render free)
MAIL_MODE=console
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=你的QQ邮箱@qq.com
SMTP_PASS=QQ邮箱SMTP授权码
SMTP_FROM_NAME=ARCANA
# Mailjet (free plan) settings for MAIL_MODE=mailjet
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAIL_FROM=你的QQ邮箱@qq.com

ALLOWED_EMAIL_DOMAINS=qq.com,foxmail.com,vip.qq.com
AUTH_CODE_TTL_MS=600000
AUTH_CODE_COOLDOWN_MS=60000
AUTH_CODE_MAX_ATTEMPTS=5
AUTH_CODES_PER_HOUR=8
AUTH_SESSION_DAYS=30

# AI request defaults for the user's starred provider
AI_TIMEOUT_MS=45000
AI_TEST_TIMEOUT_MS=15000
AI_MAX_TOKENS=2200
AI_TEMPERATURE=0.7
AI_RETRIES=0

# API abuse limits
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX=30

# Include the Capacitor/WebView origin and your deployed web domain.
CORS_ORIGINS=http://localhost:4173,http://127.0.0.1:4173,https://localhost,http://localhost,capacitor://localhost
